# ISP Analytics BI - Environment Configuration
# Copy this file to .env and update with your values

# ==========================================
# Application
# ==========================================

# Node environment: development, production, test
NODE_ENV=development

# API server port
API_PORT=3001

# Version (should match package.json)
npm_package_version=1.0.0

# ==========================================
# Database
# ==========================================

# MongoDB connection URI
# Format: mongodb://[username:password@]host:port/database
# Local: mongodb://localhost:27017/isp-bi
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/isp-bi
MONGO_URI=mongodb://localhost:27017/isp-bi

# ==========================================
# Authentication & Security
# ==========================================

# JWT Secret Key - used to sign JWT tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin - comma-separated list of allowed origins
# Examples: http://localhost:3000,https://app.example.com
CORS_ORIGIN=*

# ==========================================
# Admin User (used by bootstrap script)
# ==========================================

# Admin email for first login
ADMIN_EMAIL=admin@ispbi.local

# Admin password (minimum 8 characters)
# IMPORTANT: Change this after first login
ADMIN_PASS=admin123

# ==========================================
# License Management
# ==========================================

# License key for ISP Analytics BI
# Obtain from https://license.libernet.com.br
LICENSE_KEY=your-license-key-here

# Hostname for license validation
# Usually the server hostname or domain
HOSTNAME=localhost

# ==========================================
# ERP Connectors Configuration
# ==========================================

# -------- IXC Configuration --------
# IXC API endpoint
IXC_API_URL=https://ixc.example.com/api

# IXC API credentials
IXC_API_KEY=your-ixc-api-key
IXC_API_SECRET=your-ixc-api-secret

# -------- HubSoft Configuration --------
# HubSoft API endpoint
HUBSOFT_API_URL=https://hubsoft.example.com/api

# HubSoft API credentials
HUBSOFT_API_KEY=your-hubsoft-api-key
HUBSOFT_API_SECRET=your-hubsoft-api-secret

# -------- Sistema de Gestão Padrão (SGP) Configuration --------
# SGP API endpoint
SGP_API_URL=https://sgp.example.com/api

# SGP API credentials
SGP_API_KEY=your-sgp-api-key
SGP_API_SECRET=your-sgp-api-secret

# -------- MKAuth Configuration --------
# MKAuth API endpoint
MKAUTH_API_URL=https://mkauth.example.com/api

# MKAuth API credentials
MKAUTH_API_KEY=your-mkauth-api-key
MKAUTH_API_SECRET=your-mkauth-api-secret

# ==========================================
# Logging
# ==========================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ==========================================
# Sync Configuration (Optional)
# ==========================================

# Incremental sync interval (cron expression)
# Default: every 5 minutes (*/5 * * * *)
# Cron format: minute hour dayOfMonth month dayOfWeek
SYNC_INCREMENTAL_CRON=*/5 * * * *

# Full sync time (cron expression)
# Default: daily at 03:00 (0 3 * * *)
SYNC_FULL_CRON=0 3 * * *

# Sync timeout in milliseconds
SYNC_TIMEOUT=300000

# ==========================================
# Frontend
# ==========================================

# Path to frontend dist folder
# Default: ../frontend-dist (relative to src/index.js)
FRONTEND_DIST=../frontend-dist

# ==========================================
# Optional: Email Configuration
# For future notifications feature
# ==========================================

# Email service provider: smtp, sendgrid, ses
EMAIL_PROVIDER=smtp

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# Email from address
EMAIL_FROM=noreply@ispbi.example.com

# ==========================================
# Optional: Cloud Storage
# For future backup feature
# ==========================================

# Storage provider: local, s3, gcs
STORAGE_PROVIDER=local

# S3 Configuration (if using AWS S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=isp-bi-backups

# ==========================================
# Development Only
# ==========================================

# Enable debug logging
DEBUG=false

# Enable API request/response logging
API_LOG_VERBOSE=false

# Disable authentication for development
# WARNING: Never use in production!
DISABLE_AUTH=false
